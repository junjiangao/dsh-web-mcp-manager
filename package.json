{
  "name": "dsh-web-mcp-manager",
  "version": "0.1.0",
  "description": "Web settings panel and Host lifecycle manager for user-owned MCP servers in DeepSeek Harness",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/junjiangao/dsh-web-mcp-manager.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -b && tsdown",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "pack:check": "npm pack --dry-run"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-attachment": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-brand": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-client-connection": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-host-plugin-inventory": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-invariants": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-mcp-client": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-settings": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-scope": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-session": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-subprocess": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-timeout": ">=0.1.2-alpha.1 <0.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-attachment": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-brand": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-client-connection": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-host-plugin-inventory": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-invariants": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-mcp-client": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-scope": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-session": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-subprocess": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-settings": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-timeout": ">=0.1.2-alpha.1 <0.2.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "react": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
